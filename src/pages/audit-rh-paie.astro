testation France Travail",""],["Calculs et justificatifs des indemnités de rupture",""],["Contentieux sociaux, transactions et décisions de justice","Si applicable"],["Balance et grand livre des comptes de personnel/charges sociales","3 exercices et exercice en cours"],["Écritures d'intégration et rapprochements paie/comptabilité",""],["Provisions CP, RTT, primes, litiges et engagements sociaux",""],["Contrôles URSSAF, inspection du travail et suites de contrôle","Si applicable"],["Procédures de contrôle interne et habilitations des logiciels RH/paie",""],["Registre RGPD des traitements RH/paie et règles de conservation",""]]]],"btp":[["09","BTP — champ d'application et affiliation",[["Justificatifs d'activité BTP et de rattachement à la CCN","Ouvriers, ETAM, cadres, selon activités réellement exercées"],["Affiliations à la caisse CIBTP compétente","N° adhérent et établissements"],["Attestations CIBTP et relevés de compte",""],["Historique des déclarations et paiements CIBTP","36 mois"],["Certificats et états des droits aux congés",""],["Justificatifs des affiliations PRO BTP / autres caisses de branche","Mutuelle, prévoyance et retraite"],["Paramétrage des cotisations et garanties conventionnelles BTP",""],["Documents de suivi des salariés intérimaires et sous-traitants","Si applicable"]]],["10","BTP — paie, déplacements et intempéries",[["Barèmes conventionnels d'indemnités de repas, trajet et transport","Versions applicables aux périodes contrôlées"],["Tableaux des zones et distances de déplacement","Domicile, dépôt, chantier selon règles applicables"],["Fiches de chantier / ordres de mission et lieux d'intervention",""],["Calculs des indemnités de petits déplacements","Repas, trajet, transport"],["Ordres et justificatifs de grands déplacements","Hébergement, restauration, transport"],["Justificatifs des indemnités soumises ou exonérées de cotisations",""],["Déclarations de chômage-intempéries et demandes de remboursement","Si applicable"],["Suivi et calcul de l'indemnisation des heures d'intempéries","Si applicable"],["Historique des déductions forfaitaires spécifiques","Si applicable et selon les règles de l'année auditée"],["Plannings, heures supplémentaires et repos par chantier",""]]],["11","BTP — prévention et obligations chantier",[["Cartes d'identification professionnelle BTP / justificatifs","Salariés concernés"],["Plans particuliers de sécurité et de protection de la santé (PPSPS)","Chantiers concernés"],["Plans de prévention et protocoles de sécurité","Selon nature des interventions"],["Habilitations électriques et autorisations de conduite","Si concerné"],["CACES et attestations de formation nécessaires aux postes","Si concernés"],["Registres de remise des EPI et formations au risque chantier",""],["Vérifications périodiques du matériel et des équipements","Si applicable"],["Attestations de vigilance des sous-traitants","Lorsque requises"],["Justificatifs relatifs au détachement et à la carte BTP des salariés détachés","Si applicable"]]]]}</script>
    <script is:inline>
      (() => {
        const source = document.getElementById('documents-data');
        const DATA = JSON.parse(source.textContent);
        const modeButtons = [...document.querySelectorAll('[data-mode]')];
        const root = document.getElementById('checklist');
        const search = document.getElementById('recherche');
        const onlyMissing = document.getElementById('filtre-restantes');
        const form = document.getElementById('audit-form');
        const feedback = document.getElementById('retour-envoi');
        let currentMode = 'general';
        // Les statuts restent uniquement en mémoire de l'onglet jusqu'à export ou envoi explicite.
        const statuses = {};
        const getGroups = () => currentMode === 'btp' ? [...DATA.general, ...DATA.btp] : DATA.general;
        const options = [
          ['a_fournir','À fournir'], ['transmis','Disponible / transmis'],
          ['en_cours','En cours de préparation'], ['na','Non applicable']
        ];
        const escapeHTML = (input) => String(input ?? '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
        const allDocs = () => getGroups().flatMap(group => group[2].map((doc, index) => ({
          id:group[0]+'-'+index,
          group:group[1],
          name:doc[0],
          hint:doc[1],
          btp:Number(group[0]) >= 9
        })));
        const statusFor = id => statuses[id] || 'a_fournir';
        const labelFor = status => options.find(row=>row[0]===status)?.[1] || status;

        function render(){
          root.innerHTML = getGroups().map(group => {
            const docs = group[2].map((doc,index)=>({id:group[0]+'-'+index,name:doc[0],hint:doc[1]}));
            return '<details class="doc-group" open data-group="'+group[0]+'"><summary><span>'+
              escapeHTML(group[1])+'<span class="doc-count">'+docs.length+' pièces</span></span></summary><div class="doc-lines">'+
              docs.map(doc => '<div class="doc-line" data-doc="'+doc.id+'"><div class="doc-label">'+escapeHTML(doc.name)+
              (Number(group[0]) >= 9 ? '<span class="special-tag">BTP</span>':'')+
              (doc.hint?'<span class="doc-note">'+escapeHTML(doc.hint)+'</span>':'')+
              '</div><select class="doc-status" aria-label="Statut : '+escapeHTML(doc.name)+'" data-id="'+doc.id+'" data-status="'+statusFor(doc.id)+'">'+
              options.map(opt=>'<option value="'+opt[0]+'"'+(statusFor(doc.id)===opt[0]?' selected':'')+'>'+opt[1]+'</option>').join('')+
              '</select></div>').join('')+'</div></details>';
          }).join('');
          root.querySelectorAll('.doc-status').forEach(select=>select.addEventListener('change', event=>{
            statuses[event.target.dataset.id]=event.target.value;
            event.target.dataset.status=event.target.value;
            updateMetrics();
            filterRows();
          }));
          updateMetrics();filterRows();
          document.dispatchEvent(new Event("hitechrh:render-list"));
        }
        function updateMetrics(){
          const docs=allDocs();
          const transmitted=docs.filter(d=>statusFor(d.id)==='transmis').length;
          const pending=docs.filter(d=>statusFor(d.id)==='a_fournir').length;
          const assessed=docs.filter(d=>statusFor(d.id)!=='a_fournir').length;
          document.getElementById('metric-total').textContent=docs.length;
          document.getElementById('metric-transmis').textContent=transmitted;
          document.getElementById('metric-restant').textContent=pending;
          const progress=Math.round(100*assessed/(docs.length||1));
          document.getElementById('progress').setAttribute('aria-valuenow',String(progress));
          document.getElementById('progress-bar').style.width=progress+'%';
        }
        function filterRows(){
          const query=search.value.trim().toLocaleLowerCase('fr');
          let visible=0;
          root.querySelectorAll('.doc-group').forEach(group=>{
            let count=0;
            group.querySelectorAll('.doc-line').forEach(row=>{
              const matches=(!query||row.textContent.toLocaleLowerCase('fr').includes(query)) && (!onlyMissing.checked||statusFor(row.dataset.doc)!=='transmis'&&statusFor(row.dataset.doc)!=='na');
              row.hidden=!matches;
              if(matches) count++;
            });
            group.hidden=count===0;
            if(query&&count) group.open=true;
            visible+=count;
          });
          document.getElementById('aucun-resultat').classList.toggle('visible',visible===0);
        }
        function switchMode(mode){
          currentMode=mode;
          modeButtons.forEach(b=>b.setAttribute('aria-selected',String(b.dataset.mode===mode)));
          root.setAttribute('aria-labelledby','mode-'+mode);
          document.getElementById('type-audit').value=mode==='btp'?'BTP':'Général';
          feedback.className='feedback';
          feedback.textContent='';
          render();
        }
        modeButtons.forEach(button=>button.addEventListener('click',()=>switchMode(button.dataset.mode)));
        search.addEventListener('input',filterRows);
        onlyMissing.addEventListener('change',filterRows);
        document.getElementById('ouvrir-tout').addEventListener('click',()=>root.querySelectorAll('details').forEach(d=>d.open=true));
        document.getElementById('fermer-tout').addEventListener('click',()=>root.querySelectorAll('details').forEach(d=>d.open=false));
        document.getElementById('imprimer').addEventListener('click',()=>{root.querySelectorAll('details').forEach(d=>d.open=true);window.print();});
        document.getElementById('reinitialiser').addEventListener('click',()=>{
          if(!window.confirm('Réinitialiser tous les statuts de collecte de cette page ?')) return;
          Object.keys(statuses).forEach(key=>delete statuses[key]);render();
        });
        const csvCell=v=>'"'+String(v??'').replaceAll('"','""')+'"';
        function getSummary(){
          return allDocs().map(d=>[d.group,d.name,d.hint,labelFor(statusFor(d.id))].join(' | ')).join('\n');
        }
        document.getElementById('export-csv').addEventListener('click',()=>{
          const docs=allDocs();
          const header=['Type d’audit','Entreprise','SIRET','Contact','Email','Période','Rubrique','Pièce demandée','Précisions','Statut'];
          const info=[currentMode==='btp'?'BTP':'Général',form.raison_sociale.value,form.siret.value,form.contact_nom.value,form.contact_email.value,form.periode.value];
          const rows=[header,...docs.map(d=>[...info,d.group,d.name,d.hint,labelFor(statusFor(d.id))])];
          const csv='\uFEFF'+rows.map(r=>r.map(csvCell).join(';')).join('\r\n');
          const url=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8;'}));
          const link=document.createElement('a');
          link.href=url;
          link.download='hitechrh-collecte-'+currentMode+'-'+new Date().toISOString().slice(0,10)+'.csv';
          document.body.appendChild(link);link.click();link.remove();
          setTimeout(()=>URL.revokeObjectURL(url),1000);
        });
        form.addEventListener('submit',async event=>{
          event.preventDefault();
          feedback.className='feedback';feedback.textContent='';
          if(!form.reportValidity()) return;
          if(!document.getElementById('accord-envoi').checked){feedback.className='feedback error';feedback.textContent='Merci de confirmer la déclaration avant l’envoi.';return;}
          const btn=document.getElementById('envoyer');
          btn.disabled=true;btn.textContent='Envoi en cours…';
          try{
            document.getElementById('synthese-documents').value=getSummary();
            const payload = new URLSearchParams(new FormData(form));
            // Les statuts sont seuls transmis, jamais des fichiers salariés.
            const res=await fetch('/',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:payload.toString()});
            if(!res.ok) throw new Error('Le service ne confirme pas la réception.');
            feedback.className='feedback success';
            feedback.textContent='Votre synthèse documentaire a été transmise. Conservez un export CSV pour vos archives.';
          }catch(error){
            feedback.className='feedback error';
            feedback.textContent='L’envoi n’a pas été confirmé. Exportez votre synthèse en CSV et contactez votre interlocuteur HI-TECH RH. Aucun document n’a été téléversé.';
          }finally{btn.disabled=false;btn.textContent='Transmettre la synthèse à HI-TECH RH';}
        });
        render();
      })();
    </script>
    <script>import "../scripts/sharepoint-upload.js";</script>
  </body>
</html>
